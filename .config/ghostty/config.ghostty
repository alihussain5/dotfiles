command = shell:if [ -x /opt/homebrew/bin/fish ]; then exec /opt/homebrew/bin/fish; elif [ -x /home/linuxbrew/.linuxbrew/bin/fish ]; then exec /home/linuxbrew/.linuxbrew/bin/fish; elif [ -x /usr/bin/fish ]; then exec /usr/bin/fish; else exec /bin/sh; fi
font-family = MesloLGS NF
font-size = 12
theme = Kanagawa Wave
mouse-hide-while-typing = true
window-padding-x = 2
window-padding-y = 2
keybind = super+t=unbind
